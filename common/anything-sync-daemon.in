#!/bin/bash
# shellcheck disable=SC1091,SC2015
# Anything-sync-daemon by graysky <graysky AT archlinux DOT us>
# Requires Bash 4.0+

# shellcheck source=./asd-lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/asd-lib.sh"
set -euo pipefail

# Color constants
BLD="\e[01m"; RED="\e[01;31m"; GRN="\e[01;32m"; BLU="\e[01;34m"; NRM="\e[00m"; VERS="@VERSION@"

# shellcheck disable=SC2317,SC2329
_error_handler() {
  local line=$1
  local cmd=$BASH_COMMAND
  ediag "An unexpected error occurred at line $line while executing: '$cmd'. Aborting..."
  exit 1
}
trap '_error_handler $LINENO' ERR

# ---------------------------------------------------------------------------
# Setup & Logic Helpers
# ---------------------------------------------------------------------------

setup_early() {
  command -v flock >/dev/null 2>&1 || croak "I require flock but it's not installed. Aborting."
  LEGACY_ROOT_LOCK="${LEGACY_ROOT_LOCK:-/run/asd}"
  if [[ -f "$LEGACY_ROOT_LOCK" && $(stat -c %u "$LEGACY_ROOT_LOCK") -eq 0 ]]; then
    croak "A legacy root installation is active. Run 'sudo asd unsync' and remove the service first."
  fi

  ASDCONF="${ASDCONF:-${XDG_CONFIG_HOME:-$HOME/.config}/asd/asd.conf}"
  DAEMON_FILE="${DAEMON_FILE:-${XDG_RUNTIME_DIR:-/tmp}/asd}"
  CRASH_RECOVERY_SUFFIX="crashrecovery"
  ASDNAME="asd"
  ASD_USER=$(id -un); ASD_GROUP=$(id -gn)

  if [[ "$ASDCONF" != "/etc/asd.conf" && "$ASDCONF" != "${XDG_CONFIG_HOME:-$HOME/.config}/asd/asd.conf" ]]; then
    local suffix; suffix=$(realpath "$ASDCONF" | sha256sum | cut -b -16)
    ASDNAME="$ASDNAME-$suffix"
    [[ "$DAEMON_FILE" == "${XDG_RUNTIME_DIR:-/tmp}/asd" ]] && DAEMON_FILE="${XDG_RUNTIME_DIR:-/tmp}/$ASDNAME"
  fi
  LOCKFILE="${LOCKFILE:-${XDG_RUNTIME_DIR:-/tmp}/$ASDNAME-lock}"

  [[ "${FLOCKER:-}" != "$0" ]] && echo -e "${RED}Waiting for lock...${NRM}" && exec env FLOCKER="$0" flock -e "$LOCKFILE" "$0" "$@" || :
}

is_yes() { case "${1,,}" in y|yes|true|t|on|1|enabled|enable|use) return 0 ;; *) return 1 ;; esac; }

# shellcheck disable=SC2329
_set_paths() {
  DIR="$1"
  [[ ${DIR##*/} == .* ]] && BACKUP="${DIR%/*}/${DIR##*/}-backup_asd" || BACKUP="${DIR%/*}/.${DIR##*/}-backup_asd"
  [[ ${DIR##*/} == .* ]] && BACK_OLD="${DIR%/*}/${DIR##*/}-backup_asd-old" || BACK_OLD="${DIR%/*}/.${DIR##*/}-backup_asd-old"
  TMP="$VOLATILE/$ASDNAME-$ASD_USER$DIR"
  UPPER="$TMP-rw"; WORK="$VOLATILE/.$ASDNAME-$ASD_USER$DIR"
}

setup_late() {
  if [[ -f "$ASDCONF" ]]; then
    [[ ! -f "$DAEMON_FILE" ]] && grep -Eqv "^$|^\s*['\")#]|^[^ ]*=[^;]*" "$ASDCONF" && croak "Syntax error(s) detected in $ASDCONF"
    # shellcheck source=./asd.conf
    . "$ASDCONF"
  else
    croak "Cannot find $ASDCONF. Reinstall package."
  fi

  [[ -f "${DAEMON_FILE}.conf" ]] && { unset WHATTOSYNC USE_OVERLAYFS USE_BACKUPS VOLATILE; . "${DAEMON_FILE}.conf"; }

  [[ "${BACKUP_LIMIT:-}" =~ ^[0-9]+$ ]] || BACKUP_LIMIT=5
  shopt -s extglob; VOLATILE="${VOLATILE:-}"; VOLATILE="${VOLATILE%%+(/)}"; shopt -u extglob
  [[ -z "$VOLATILE" ]] && VOLATILE="${XDG_RUNTIME_DIR:-/tmp}"
  
  df -T "$VOLATILE" | grep -m 1 -q '\( tmpfs \|^/dev/zram\)' || croak "$VOLATILE is not tmpfs/zram. Aborting."
  [[ -z "${ENABLE_HARDLINK_SAFETY_CHECK:-}" ]] && ENABLE_HARDLINK_SAFETY_CHECK=1
  
  is_yes "${USE_OVERLAYFS:-}" && OLFS=1 || OLFS=0
  is_yes "${USE_BACKUPS:-yes}" && CRRE=1 || CRRE=0
  is_yes "${USE_XATTRS:-}" && RSYNC_OPTS="-aX" || RSYNC_OPTS="-a"

  if [[ $OLFS -eq 1 ]]; then
    command -v fuse-overlayfs >/dev/null 2>&1 || { echo "fuse-overlayfs missing, falling back"; OLFS=0; }
  fi

  distro=$(source /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-$NAME}" || sed 's| \\.*$||' /etc/issue | head -n 1)
}

# ---------------------------------------------------------------------------
# Task & Iterator Logic
# ---------------------------------------------------------------------------

# shellcheck disable=SC2329
_ungraceful_check_dir() {
  local DIR="$1" BACKUP BACK_OLD TMP UPPER WORK NOW; _set_paths "$DIR"
  [[ -e "$TMP"/.flagged || (! -d "$BACKUP" && ! -L "$DIR") ]] && return 0
  echo "Ungraceful state detected for $DIR so fixing"; NOW=$(date +%Y%m%d_%H%M%S)
  [[ -L "$DIR" ]] && rm "$DIR"; mountpoint -q "$TMP" && fusermount3 -u "$TMP"
  rm -rf "$TMP" "$UPPER" "$WORK"
  [[ -d "$BACK_OLD" ]] && { [[ $CRRE -eq 1 ]] && tar cf - -C "${BACK_OLD%/*}" "${BACK_OLD##*/}" | pv -s "$(du -sb "$BACK_OLD" | awk '{print $1}')" | zstd >"$BACKUP-$CRASH_RECOVERY_SUFFIX-$NOW.tar.zstd"; rm -rf "$BACK_OLD"; }
  [[ -d "$BACKUP" ]] && mv "$BACKUP" "$DIR"
}

# shellcheck disable=SC2329
_cleanup_dir() {
  local DIR="$1" BACKUP TMP UPPER WORK; _set_paths "$DIR"
  local -a CRASHArr; mapfile -t CRASHArr < <(find "${BACKUP%/*}" -maxdepth 1 -name "${BACKUP##*/}-$CRASH_RECOVERY_SUFFIX-*" 2>/dev/null | sort -r)
  if [[ ${#CRASHArr[@]} -gt 0 ]]; then
    echo -e "${BLD}Deleting ${#CRASHArr[@]} snapshots for ${BLU}$DIR${NRM}"
    rm -rf "${CRASHArr[@]}"
  else
    echo -e "${BLD}No snapshots for: ${BLU}$DIR${NRM}"
  fi
}

# shellcheck disable=SC2329
_enforce_dir() {
  local DIR="$1" BACKUP TMP UPPER WORK; _set_paths "$DIR"
  local -a CRASHArr; mapfile -t CRASHArr < <(find "${BACKUP%/*}" -maxdepth 1 -name "${BACKUP##*/}-$CRASH_RECOVERY_SUFFIX-*" 2>/dev/null | sort -r)
  [[ ${#CRASHArr[@]} -gt $BACKUP_LIMIT ]] && rm -rf "${CRASHArr[@]:$BACKUP_LIMIT}"
}

# shellcheck disable=SC2329
_sync_dir() {
  local DIR="$1" BACKUP BACK_OLD TMP UPPER WORK; _set_paths "$DIR"
  if [[ -e "$TMP"/.flagged ]]; then
    set -x; rsync "$RSYNC_OPTS" --delete-after --exclude .flagged "$TMP/" "$BACKUP/"; set +x
  elif [[ -d "$DIR" && ! -L "$DIR" ]]; then
    local P; P=$(stat -c %a "$DIR")
    [[ $CRRE -eq 1 ]] && { rm -rf "$BACK_OLD"; set -x; rsync "$RSYNC_OPTS" --link-dest="$DIR" "$DIR/" "$BACK_OLD/"; set +x; }
    mv "$DIR" "$BACKUP"
    if [[ $OLFS -eq 1 ]]; then
      mkdir -p "$UPPER" "$WORK" "$TMP"; chmod "$P" "$UPPER" "$WORK" "$TMP"
      fuse-overlayfs -o lowerdir="$BACKUP",upperdir="$UPPER",workdir="$WORK" "$TMP"
    else
      mkdir -p "$TMP"; chmod "$P" "$TMP"; set -x; rsync "$RSYNC_OPTS" "$BACKUP/" "$TMP/"; set +x
    fi
    ln -s "$TMP" "$DIR"; touch "$TMP"/.flagged
  fi
}

# shellcheck disable=SC2329
_unsync_dir() {
  local DIR="$1" BACKUP BACK_OLD TMP UPPER WORK; _set_paths "$DIR"
  [[ -L "$DIR" ]] || return 0
  rm "$DIR"; mountpoint -q "$TMP" && fusermount3 -u "$TMP"; rm -rf "$TMP" "$UPPER" "$WORK"
  [[ -d "$BACKUP" ]] && mv "$BACKUP" "$DIR"
  [[ $CRRE -eq 1 ]] && rm -rf "$BACK_OLD"
}

# shellcheck disable=SC2329
_parse_dir() {
  local DIR="$1" BACKUP TMP UPPER WORK; _set_paths "$DIR"
  [[ -d "$DIR" || -L "$DIR" ]] || return 0
  local -a rec; mapfile -t rec < <(find "${BACKUP%/*}" -maxdepth 1 -name "${BACKUP##*/}-$CRASH_RECOVERY_SUFFIX-*" 2>/dev/null | sort -r)
  printf " %-18s %s\n" "${BLD}owner/group id:" "$ASD_USER/$ASD_GROUP${NRM}" \
         "${BLD}target to manage:" "${GRN}$DIR${NRM}" \
         "${BLD}sync target:" "${BLU}$BACKUP${NRM}" \
         "${BLD}tmpfs target:" "${RED}$TMP${NRM}" \
         "${BLD}recovery dirs:" "$([[ ${#rec[@]} -eq 0 ]] && echo "none" || echo -e "${RED}${#rec[@]}${NRM}${BLD} <- delete with c")"
  for b in "${rec[@]}"; do printf " %-18s %s\n" "${BLD} dir path:" "${BLU}$b${NRM}"; done
  echo
}

for_each_dir() {
  local task="$1"; shift; for dir in "${!WHATTOSYNC[@]}"; do [[ "$task" == "_parse_dir" ]] && "$task" "$dir" "$@" || "$task" "$dir" "$@" & done; wait
}

# ---------------------------------------------------------------------------
# Command Dispatcher
# ---------------------------------------------------------------------------

dep_check() {
  for cmd in rsync awk pv tar zstd; do command -v "$cmd" >/dev/null 2>&1 || croak "I require $cmd but it's not installed."; done
  [[ $OLFS -eq 1 ]] && { command -v fuse-overlayfs >/dev/null 2>&1 || croak "fuse-overlayfs required for overlay mode."; }
}

header() { echo -e "${BLD}Anything-sync-daemon v$VERS${NRM}${BLD} on $distro${NRM}\n"; }

parse() {
  header; if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files asd.service >/dev/null 2>&1; then
    for u in asd asd-resync.timer; do
      local state; state=$(systemctl --user show -p ActiveState --value "$u")
      local color; [[ "$state" == "active" ]] && color="$GRN" || color="$RED"
      echo -e " ${BLD}Systemd user $([[ "$u" == *timer ]] && echo "timer" || echo "service") is ${color}${state}${NRM}${BLD}.${NRM}"
    done
  else
    echo -e " ${BLD}Daemon pid: $([[ -f $DAEMON_FILE ]] && echo -e "${GRN}present" || echo -e "${RED}not present")${NRM}${BLD}. Resync: ${RED}not present (legacy)${NRM}${BLD}.${NRM}"
  fi
  echo -e "${BLD} Overlayfs: $([[ $OLFS -eq 1 ]] && echo -e "${GRN}active" || echo -e "${RED}inactive")${NRM}${BLD}. Syncing from ${BLU}${ASDCONF}${NRM}${BLD}:${NRM}\n"
  for_each_dir _parse_dir
}

main() {
  case "${1:-}" in
    p*|Preview*) dep_check; parse ;;
    c*|Clean*) header; dep_check; for_each_dir _cleanup_dir ;;
    sync) [[ -f "$DAEMON_FILE" ]] && echo -e "${GRN}ASD already running" || { dep_check; for_each_dir _ungraceful_check_dir; for_each_dir _sync_dir; for_each_dir _enforce_dir; touch "$DAEMON_FILE"; cp "$ASDCONF" "${DAEMON_FILE}.conf"; } ;;
    resync) [[ -f "$DAEMON_FILE" ]] && for_each_dir _sync_dir || echo -e "${RED}ASD not running" ;;
    unsync) [[ -f "$DAEMON_FILE" ]] && { for_each_dir _sync_dir; for_each_dir _unsync_dir; rm -f "$DAEMON_FILE" "${DAEMON_FILE}.conf"; } || echo -e "${RED}ASD not running" ;;
    *) header; cat <<EOF
 $0 ${GRN}[option]${NRM}
   ${GRN}preview${NRM}  Parse config to see targets.
   ${GRN}clean${NRM}    Delete all snapshots.
   ${GRN}resync${NRM}   Synchronize RAM and disk.
   ${RED}sync${NRM}     Force manual sync (discouraged).
   ${RED}unsync${NRM}   Force manual unsync (discouraged).

 Use systemd for management: ${BLU}systemctl --user [start|stop|enable] asd${NRM}
EOF
    ;;
  esac
}

setup_early "$@"; setup_late
declare -a wts; wts=("${WHATTOSYNC[@]+"${WHATTOSYNC[@]}"}"); unset WHATTOSYNC; declare -A WHATTOSYNC; shopt -s extglob
for dir in "${wts[@]}"; do dir="${dir%%+(/)}"; [[ -n "$dir" ]] && WHATTOSYNC["$dir"]="$dir"; done
main "$@"
exit 0
# vim:set ts=2 sw=2 et:
